# Nginx reverse proxy for music.yeuxark.com
# Place under /etc/nginx/sites-available/ and enable.

upstream kazam_backend {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name music.yeuxark.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name music.yeuxark.com;

    # ssl_certificate     /etc/letsencrypt/live/music.yeuxark.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/music.yeuxark.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://kazam_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Audio streaming benefits from longer timeouts + range
    location /api/stream/ {
        proxy_pass http://kazam_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
