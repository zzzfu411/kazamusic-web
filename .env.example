# KAZAM VPS 配置示例
# 复制为 .env 后按需修改

# 监听（容器内一般 8080，由 Nginx 反代）
HOST=0.0.0.0
PORT=8080

# 对外公开的根地址（用于生成分享链接、embed）
PUBLIC_BASE_URL=https://music.yeuxark.com

# 允许跨域的来源（逗号分隔），个人主页必须加进来
CORS_ORIGINS=https://yeuxark.com,https://www.yeuxark.com,https://music.yeuxark.com

# 上游网易云代理 API
UPSTREAM_API=https://api.chksz.top/api

# 默认音质：jymaster / lossless / hires / exhigh / higher / standard
AUDIO_LEVEL=exhigh

# 日志级别
LOG_LEVEL=INFO

# 信任反向代理头（Nginx 后必须 true）
TRUST_PROXY=true

# 服务端歌曲缓存目录（音频落盘，抗 CDN 过期）
CACHE_DIR=./data/cache
CACHE_MAX_SONGS=0

# 管理员（连点 Logo 5 次后输入）。缓存/复制 stream 地址需此密码
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL=86400
